<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- No PackageReference: ASP.NET Core's shared framework already carries everything this page
       needs (Kestrel + Razor). That is deliberate and is dotnet's distinctive air-gap lesson — the
       FRAMEWORK is the dependency, and it ships inside the runtime image rather than being
       restored. The builder image below still exists (every app has one, by decision) and still
       does a real `dotnet restore`, which is what makes the in-cluster build offline-safe. -->
  <PropertyGroup>
    <!-- The app's DECLARED semantic version. Read by scripts/lib/apps.sh:app_version(); the
         Tekton build tags the pushed image with it alongside the commit sha. -->
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DotnetWebapp</RootNamespace>
  </PropertyGroup>

  <!-- The Web SDK globs **/*.cs, so WITHOUT this the app project compiles tests/ into itself and
       fails with CS0246 'TUnit could not be found' — attributed to THIS csproj, not the test one.
       It would also break the image build, whose `COPY . .` + `dotnet build` hits the same glob. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
