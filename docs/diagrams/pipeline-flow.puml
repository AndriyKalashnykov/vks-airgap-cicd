@startuml pipeline-flow
!include c4/C4_Dynamic.puml
!include _style.puml

' TOP-DOWN layout (plain Rel, no LAYOUT_LEFT_RIGHT and no Rel_R/Rel_L direction hints):
' left-to-right chaining renders a very wide strip that clips at PlantUML's 4096px default
' (PLANTUML_LIMIT_SIZE). The render also raises that limit (Makefile _render_diagrams) as a backstop.
'
' ONE LANE, not one per app. This used to draw two lanes (1a/1b, 2a/2b, ...) back when the repo had
' two apps; it now has SIX, and six lanes is unreadable. The walk is IDENTICAL for every app, so the
' diagram shows it ONCE with <app> placeholders and the registry named on the boxes. The only shared
' object in the CI intake is the EventListener: a SINGLE listener for every app, which label-selects
' the per-app Trigger CRs (vks-airgap-cicd/ci: app), each CEL-filtered on body.repository.name -- so
' a push to one app's repo fires ONLY that app's pipeline. Lanes differ only in the TEST task and the
' base images they build FROM (scripts/lib/apps.sh: app_test_task / app_builder_image /
' app_runtime_image).

title Pipeline flow — a push to production, inside the air gap (the same walk for every app)

Person(dev, "Developer")
Container(gitea_app, "Gitea: <app>-app", "git repo · one per row of apps/registry.tsv (six today)")
Container(el, "Tekton EventListener 'apps'", "ONE listener for every app;\nlabel-selects the per-app Trigger CRs")
Container(pipe_app, "PipelineRun <app>-ci", "clone · test (per language) · kaniko · write-back")
ContainerDb(harbor, "Harbor", "OCI registry", $tags="datastore")
Container(dep_app, "Gitea: <app>-deploy", "git repo · ArgoCD watches this one")
Container(argo, "ArgoCD", "one Application per app")
Container(app_run, "<app>", "Deployment (2 replicas) + Service")

Rel(dev, gitea_app, "git push")
Rel(gitea_app, el, "push webhook")
Rel(el, pipe_app, "Trigger <app>\n(CEL on repository.name)")
Rel(pipe_app, pipe_app, "test, OFFLINE\n(the app's deps-baked builder)")
Rel(pipe_app, harbor, "kaniko push\napps/<app>:<sha>")
Rel(pipe_app, dep_app, "commit the new tag")
Rel(dep_app, argo, "auto-sync")
Rel(argo, app_run, "deploy")
Rel(harbor, app_run, "pull image")

SHOW_LEGEND()
@enduml
